{
  "name": "club-racing-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UK motorcycle club racing calendar, aggregated.",
  "scripts": {
    "build": "node build.js",
    "serve": "node build.js && node --run serve:only",
    "serve:only": "node -e \"import('node:http').then(async({default:h})=>{const{readFile}=await import('node:fs/promises');const{join,extname}=await import('node:path');const T={'.html':'text/html','.css':'text/css','.ics':'text/calendar','.js':'text/javascript','.xml':'application/xml'};h.createServer(async(q,s)=>{let p=join('dist',decodeURIComponent(q.url.split('?')[0]));if(!extname(p))p=join(p,'index.html');try{const b=await readFile(p);s.writeHead(200,{'content-type':T[extname(p)]||'application/octet-stream'});s.end(b)}catch{s.writeHead(404);s.end('not found')}}).listen(8080,()=>console.log('http://localhost:8080'))})\""
  }
}
